# Sem DATABASE_URL, a API usa um Postgres embutido (PGlite) em ./.data/pglite.
# Em produção, aponte para um Postgres gerenciado:
# DATABASE_URL=postgres://usuario:senha@host:5432/minha_companhia
PORT=4175
HOST=127.0.0.1
# production liga o cookie Secure e bloqueia o seed
NODE_ENV=development
# na Vercel, o build de preview só aplica as migrations com 1 (use quando o Preview tiver banco próprio, não o da produção)
# PREVIEW_COM_BANCO_PROPRIO=1
# segredo dos links de assinatura da agenda (obrigatório em produção; troque e todos os links mudam)
# SEGREDO_AGENDA=uma-frase-longa-e-aleatoria
# e-mail (Resend). Sem a chave, fora de produção o código só aparece no log; em produção responde 503.
# O remetente precisa ser de um domínio verificado no Resend.
# RESEND_API_KEY=re_...
# EMAIL_REMETENTE=Minha companhia <nao-responda@minhacompanhia.com.br>
# 1 exige o código do WhatsApp no cadastro profissional (além do e-mail). Desligado, só o e-mail é exigido.
# VERIFICAR_WHATSAPP=1
# pagamentos (AbacatePay). Sem a chave, fora de produção o pagamento é simulado; em produção responde 503.
# A chave abc_dev_… é do modo de testes; abc_prod_… cobra de verdade.
# ABACATEPAY_API_KEY=abc_dev_...
# segredo cadastrado no webhook do AbacatePay, que aponta para https://SEU_SITE/api/pagamentos/abacatepay?webhookSecret=ESTE_SEGREDO
# ABACATEPAY_WEBHOOK_SECRET=uma-frase-longa-e-aleatoria
# endereço público das telas, para a volta do checkout (sem ele, usa o endereço do pedido)
# SITE_URL=https://minhacompanhia.com.br
# regras de dinheiro (propostas, ainda não definidas)
# TAXA_PLATAFORMA_PERCENT=12
# PRAZO_DEPOSITO_DIAS_UTEIS=2
# CANCELAMENTO_TARDIO_HORAS=24
# CANCELAMENTO_TARDIO_PERCENT=50
