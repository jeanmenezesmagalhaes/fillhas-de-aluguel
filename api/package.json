{
  "name": "minha-companhia-api",
  "version": "1.0.0",
  "description": "API de contas, sessões e avaliações da Minha companhia",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:gerar": "drizzle-kit generate",
    "db:migrar": "tsx src/scripts/migrar.ts",
    "seed": "tsx src/scripts/seed.ts",
    "vitrine": "tsx src/scripts/vitrine.ts",
    "aprovar": "tsx src/scripts/aprovar.ts",
    "admin": "tsx src/scripts/admin.ts",
    "montar-public": "tsx src/scripts/montar-public.ts",
    "vercel-build": "npm run montar-public && npm run db:migrar"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  }
}
